# Inloggegevens voor het dashboard
MONITOR_USER=admin
MONITOR_PASSWORD=verander-dit-wachtwoord

# Lange willekeurige string om sessiecookies te ondertekenen
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server
PORT=3000
HOST=0.0.0.0

# Zet op true als het dashboard via HTTPS (reverse proxy) wordt geserveerd
COOKIE_SECURE=false
# Zet op true als er een reverse proxy (nginx/caddy) voor staat
TRUST_PROXY=false

# Meting
SAMPLE_INTERVAL_SECONDS=5
RETENTION_DAYS=30
DISK_PATH=/
